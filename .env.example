# Copy this file to .env and adjust the values. Never commit .env.
# Variables already defined in the environment take precedence over this file.
# Docker Compose also reads this file to fill in docker-compose.yml.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL container (docker-compose.yml). Development values only.
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk
POSTGRES_DB=helpdesk

# PostgreSQL connection used by Django. Must match the values above.
# Use 127.0.0.1, not localhost: on Windows, localhost resolves to ::1 first and the
# connection waits for the IPv6 attempt to time out, because the port is only
# published on IPv4.
DATABASE_URL=postgres://helpdesk:helpdesk@127.0.0.1:5432/helpdesk
