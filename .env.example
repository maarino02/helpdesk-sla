# Copy this file to .env and adjust the values. Never commit .env.
# Variables already defined in the environment take precedence over this file.
# Docker Compose also reads this file to fill in docker-compose.yml.

# Django
DJANGO_SECRET_KEY=change-me
# Signs the API tokens; separate from DJANGO_SECRET_KEY so each can be rotated alone.
# At least 32 characters. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
JWT_SIGNING_KEY=change-me-to-a-long-random-value-of-32-characters-or-more
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL container (docker-compose.yml). Development values only.
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk
POSTGRES_DB=helpdesk

# Application roles created by docker/postgres/roles.sql (make db-roles).
# helpdesk_owner runs the migrations; helpdesk_app is used at runtime.
HELPDESK_OWNER_PASSWORD=helpdesk_owner
HELPDESK_APP_PASSWORD=helpdesk_app

# PostgreSQL connections used by Django. Passwords must match the values above
# (percent-encode any character that is special in a URL, such as @ : / ?).
# Use 127.0.0.1, not localhost: on Windows, localhost resolves to ::1 first and the
# connection waits for the IPv6 attempt to time out, because the port is only
# published on IPv4. connect_timeout (seconds) makes a database that stops answering
# fail fast instead of hanging each request.
# Runtime, as helpdesk_app.
DATABASE_URL=postgres://helpdesk_app:helpdesk_app@127.0.0.1:5432/helpdesk?connect_timeout=5
# Migrations (make migrate) and the test suite, as helpdesk_owner.
DATABASE_OWNER_URL=postgres://helpdesk_owner:helpdesk_owner@127.0.0.1:5432/helpdesk?connect_timeout=5

# Redis: Celery broker and readiness check. 127.0.0.1 for the same reason as above.
REDIS_URL=redis://127.0.0.1:6379/0
# Django cache (login throttling). A different database (/1) from the broker.
REDIS_CACHE_URL=redis://127.0.0.1:6379/1

# Email notifications. consolemail:// prints them to the worker log; production
# uses SMTP, e.g. smtp+tls://user:password@smtp.example.com:587.
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL="HelpDesk SLA <no-reply@localhost>"
